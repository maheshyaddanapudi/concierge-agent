{
  "uid": "concierge-llm",
  "title": "Concierge — LLM",
  "tags": ["concierge", "m53"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Provider calls / min by provider · model · status",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, model, status) (increase(concierge_llm_calls_total[1m]))",
          "legendFormat": "{{provider}}:{{model}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error class rate / min (rate_limited · timeout · unknown_model · provider_error)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(concierge_llm_calls_total{status!=\"ok\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p95 by model (5m)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(concierge_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{model}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(concierge_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{model}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Step tokens / min by model · direction",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, direction) (increase(concierge_step_tokens_sum[1m]))",
          "legendFormat": "{{model}} {{direction}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Spend today (USD, priced)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "concierge_spend_usd_today" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Spend-ceiling refusals / min by kind",
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(concierge_spend_ceiling_refusals_total[1m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Runs failed on a provider class / min",
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (kind) (increase(concierge_llm_errors_total[1m]))", "legendFormat": "{{kind}}" }
      ]
    }
  ]
}
