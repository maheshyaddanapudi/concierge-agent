# Build context for `build: ./frontend` (docker-compose.yml).
#
# The builder stage runs `npm ci` from package.json + package-lock.json and
# then `npm run build`, so the host's node_modules and dist are dead weight
# (240 MB of node_modules alone) and a stale host build must never be copied
# over the one the image produces.

# version control
.git
.gitignore

# installed + built artefacts — regenerated by `npm ci` / `npm run build`
node_modules
dist
*.tsbuildinfo

# local environment files — VITE_* values are supplied at build time, not copied
.env
.env.*

# editor / OS noise
.idea/
.vscode/
.DS_Store
