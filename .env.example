# ── LLM providers ────────────────────────────────────────────────
# All optional — presence enables that provider in Settings model selects
# (spec §2.1). At least one key (or FAKE_LLM_ENABLED=1) is needed for runs.
# First boot picks default_model from whichever providers are configured:
# anthropic → google flash → openai 5.6 luna → fake (spec §13).
# ./quick-setup.sh prompts per provider and verifies keys before saving.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional: 1 enables the scriptable fake provider for keyless demos/tests (spec §11)
FAKE_LLM_ENABLED=

# ── Database ─────────────────────────────────────────────────────
# Used by docker-compose to init the db container
POSTGRES_USER=concierge
POSTGRES_PASSWORD=concierge
POSTGRES_DB=concierge
# Used by the backend (asyncpg driver; host `db` inside compose, `localhost` outside)
DATABASE_URL=postgresql+asyncpg://concierge:concierge@db:5432/concierge

# ── Observability (all optional) ─────────────────────────────────
# LangSmith: key only — enable/endpoint/project are runtime settings in the UI (spec §10)
LANGSMITH_API_KEY=
# OTel: bootstrap default; the otlp_endpoint app setting overrides at runtime
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── App ──────────────────────────────────────────────────────────
# Sandbox root for the seeded filesystem MCP server (mounted volume)
WORKSPACE_DIR=/workspace
# optional: enables the 'redis' registry-cache mode (spec §7.3); url-with-credentials stays env-only
REDIS_URL=
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Frontend → backend base URL (Vite build-time)
VITE_API_BASE_URL=http://localhost:8000

# ── §18.4 ambient delivery channels (all optional; email/webhook stay dark unless set)
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# webhook push channel: one JSON envelope per delivery batch (SMS/push-gateway shape)
AMBIENT_WEBHOOK_URL=

# ── §18.7 custom OpenAI-compatible gateway (optional; enables the 'custom' provider)
CUSTOM_GATEWAY_BASE_URL=
CUSTOM_GATEWAY_API_KEY=
# comma-separated model ids — this env list IS the provider's validated model list
CUSTOM_GATEWAY_MODELS=

# ── §18.8 auth & tenancy (dark by default: false ⇒ byte-identical single-user)
AUTH_ENABLED=false
# bearer-session lifetime in hours when auth is on (M40)
AUTH_SESSION_TTL_H=24

# M50 — per-replica Postgres connection budget (spec §13). The pooled ceiling
# is DB_POOL_SIZE + DB_MAX_OVERFLOW; the checkpointer pool (10), the LISTEN
# connection and the ambient leader lease sit outside it. Size max_connections
# from replicas × (pool + overflow + 12) with headroom (docs/operations/scaling.md).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# M51 — bounds set once at the provider port (spec §13): the per-call timeout
# and the retry budget every adapter carries (429 backoff spends it too), and
# how long a stopping process drains in-flight runs before marking the
# remainder failed (keep it under the orchestrator's stop timeout).
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
SHUTDOWN_GRACE_S=25

# M54 — the fleet (spec §18.9). REPLICA_ID names this process (defaults to
# the container hostname — leave it empty under `--scale`); DB_REPLICAS and
# DB_MAX_CONNECTIONS declare what the connection budget is checked against
# at boot and on GET /replicas (per replica: pool + overflow + checkpointer
# 10 + 4 session connections; plus a 10-connection reserve). A statement
# cache of 0 keeps the pooled connections safe behind a transaction-mode
# pooler; the registry-cache TTL bounds any coherency gap.
# BACKEND_PORT_RANGE is the host range `docker compose up --scale backend=N`
# binds, one port per replica.
REPLICA_ID=
DB_REPLICAS=1
DB_MAX_CONNECTIONS=100
DB_STATEMENT_CACHE_SIZE=0
REGISTRY_CACHE_TTL_S=300
BACKEND_PORT_RANGE=8000-8010

# M52 — the egress policy for every outbound fetch made on someone else's
# say-so (A2A cards and calls, poll sources, HTTP MCP servers, the webhook
# channel). public = refuse loopback/link-local/private/metadata targets, by
# address and by resolution, except the hosts you name in EGRESS_ALLOW_HOSTS
# (an internal MCP server, an internal agent); allowlist = ONLY those hosts;
# open = caps only (lab use). Bodies stream under EGRESS_MAX_BYTES and are cut
# past it.
EGRESS_POLICY=public
EGRESS_ALLOW_HOSTS=
EGRESS_MAX_BYTES=5242880
# CORS pin when auth is on (e.g. http://localhost:5173)
FRONTEND_ORIGIN=
