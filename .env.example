# ── LLM providers ────────────────────────────────────────────────
# Required: default provider (anthropic:claude-sonnet-4-6)
ANTHROPIC_API_KEY=
# Optional: presence enables the provider in Settings model selects (spec §2.1)
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ── Database ─────────────────────────────────────────────────────
# Used by docker-compose to init the db container
POSTGRES_USER=concierge
POSTGRES_PASSWORD=concierge
POSTGRES_DB=concierge
# Used by the backend (asyncpg driver; host `db` inside compose, `localhost` outside)
DATABASE_URL=postgresql+asyncpg://concierge:concierge@db:5432/concierge

# ── Observability (all optional) ─────────────────────────────────
# LangSmith: key only — enable/endpoint/project are runtime settings in the UI (spec §10)
LANGSMITH_API_KEY=
# OTel: bootstrap default; the otlp_endpoint app setting overrides at runtime
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── App ──────────────────────────────────────────────────────────
# Sandbox root for the seeded filesystem MCP server (mounted volume)
WORKSPACE_DIR=/workspace
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Frontend → backend base URL (Vite build-time)
VITE_API_BASE_URL=http://localhost:8000
